  <PropertyGroup>
    <_BuildQuireMirrorHere Condition="'$(QuireMirrorPath)' == ''">true</_BuildQuireMirrorHere>
    <QuireMirrorOutDir>$(IntDir)Quire.Mirror\</QuireMirrorOutDir>
    <QuireMirrorPath Condition="'$(QuireMirrorPath)' == ''">$(QuireMirrorOutDir)Quire.Mirror.dll</QuireMirrorPath>
    <_BuildQuireMplHere Condition="'$(QuireMplPath)' == ''">true</_BuildQuireMplHere>
