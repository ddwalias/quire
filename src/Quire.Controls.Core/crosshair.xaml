<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="20"
        Height="20"
        IsHitTestVisible="False">
    <!-- Quire-authored provisional geometry: a two-line cross centred in a 20 by 20 canvas. Mathcad's crosshair.xaml is not reused (D21). -->
    <Line X1="0" Y1="10" X2="20" Y2="10" Stroke="Black" StrokeThickness="1" />
    <Line X1="10" Y1="0" X2="10" Y2="20" Stroke="Black" StrokeThickness="1" />
</Canvas>
