<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <UseIJWHost>true</UseIJWHost>
  </PropertyGroup>
  <Import Project="Generated\Mirror.props" />

  <!-- The pinned MSVC 19.51.36246 Build Tools instance (D19). The release gate sets this from vswhere and overrides it. -->
  <PropertyGroup>
    <QuireMsvcInstallDir Condition="'$(QuireMsvcInstallDir)' == ''">C:\BuildTools\VS18.6-msvc\</QuireMsvcInstallDir>
  </PropertyGroup>

  <!-- Release replaces this C# output with the C++/CLI DLL, so the build must use the pinned MSVC that built utl-mgd.dll (D19). -->
  <Target Name="RequirePinnedMsvcForMixedModeRelease" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(QuireMsvcInstallDir)' == ''"
           Text="Quire.Engine.Utl Release needs QuireMsvcInstallDir set to the MSVC 19.51.36246 Build Tools instance (D19)." />
  </Target>

  <Target Name="BuildMixedModeRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_QuireMirrorReference Include="@(ReferencePath)" Condition="'%(Filename)' == 'Quire.Mirror'" />
    </ItemGroup>
    <Error Condition="'@(_QuireMirrorReference)' == ''" Text="Quire.Mirror.dll is not among this project's references; the mixed-mode build cannot find it." />
    <!-- Rebuild, not an incremental build: an up-to-date vcxproj would leave the C# DLL copied into bin above in place. -->
    <!-- The vcxproj forces in the Quire.Mirror.dll this project already built, rather than building it a second time. -->
    <Exec Command="&quot;$(QuireMsvcInstallDir)MSBuild\Current\Bin\amd64\MSBuild.exe&quot; &quot;$(MSBuildProjectDirectory)\MixedMode\Quire.Engine.Utl.vcxproj&quot; /t:Rebuild /m /p:Configuration=Release /p:Platform=x64 /p:UtlAssemblyOutDir=&quot;$(TargetDir.TrimEnd('\'))&quot; /p:QuireMirrorPath=&quot;@(_QuireMirrorReference->'%(FullPath)')&quot; /v:minimal" />
    <!-- The mixed DLL cannot use the portable PDB emitted by the preceding C# reference build. -->
    <Delete Files="$(TargetDir)Quire.Engine.Utl.pdb" />
  </Target>
</Project>
