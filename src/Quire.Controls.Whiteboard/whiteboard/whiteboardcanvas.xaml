<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Core="clr-namespace:Quire.Controls.Core;assembly=Quire.Controls.Core"
    xmlns:Whiteboard="clr-namespace:Quire.Controls.Whiteboard"
    Focusable="True"
    Cursor="Arrow">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
      <Style x:Key="WhiteboardItemsControlCanvasStyle" TargetType="{x:Type Canvas}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Panel.IsItemsHost" Value="True" />
        <Setter Property="UIElement.AllowDrop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Width" Value="{Binding Path=ContentWidth}" />
        <Setter Property="Height" Value="{Binding Path=ContentHeight}" />
      </Style>
      <Style x:Key="WhiteboardItemStyle">
        <Style.Triggers>
          <DataTrigger Value="Try using a converter to compare the current item with WhiteboardControl.ActiveItem" Binding="{Binding Path=ActiveItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Whiteboard:WhiteboardControl}}}">
            <Setter Property="Whiteboard:WhiteboardControl.IsActive" Value="True" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Core:Crosshair Canvas.Left="{Binding Path=InsertionPoint.X}" Canvas.Top="{Binding Path=InsertionPoint.Y}" Visibility="{Binding Path=IsCrosshairVisible, Converter={StaticResource booleanToVisibilityConverter}}" />
  <ItemsControl ItemsSource="{Binding Path=WhiteboardItems}">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <Whiteboard:ItemsControlCanvas Style="{StaticResource WhiteboardItemsControlCanvasStyle}" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</Canvas>
