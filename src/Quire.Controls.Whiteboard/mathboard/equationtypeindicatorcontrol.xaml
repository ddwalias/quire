<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Mathboard="clr-namespace:Quire.Controls.Mathboard"
    xmlns:Wpf="clr-namespace:Quire.Wpf;assembly=Quire.Core">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Wpf:DecreaseValueByParameterConverter x:Key="decreaseValueByParameterConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Name="MainGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" TextTrimming="CharacterEllipsis" Text="{Binding Path=Text}" Visibility="{Binding Path=Visibility, RelativeSource={RelativeSource AncestorType=Mathboard:EquationTypeIndicatorControl}}">
      <FrameworkElement.LayoutTransform>
        <TransformGroup>
          <RotateTransform Angle="270" />
        </TransformGroup>
      </FrameworkElement.LayoutTransform>
    </TextBlock>
    <Line X1="5" Y1="0.5" X2="0.5" Y2="0.5" Grid.Row="0" Grid.Column="1" Stroke="#FF1E90FF" StrokeThickness="1" Visibility="{Binding Path=Visibility, RelativeSource={RelativeSource AncestorType=Mathboard:EquationTypeIndicatorControl}}" />
    <Line X1="0.5" Y1="0" X2="0.5" Grid.Row="0" Grid.Column="1" Stroke="#FF1E90FF" StrokeThickness="1" Y2="{Binding Height}" Visibility="{Binding Path=Visibility, RelativeSource={RelativeSource AncestorType=Mathboard:EquationTypeIndicatorControl}}" />
    <Line X1="0.5" X2="5" Grid.Row="0" Grid.Column="1" Stroke="#FF1E90FF" StrokeThickness="1" Y1="{Binding Path=Height, Converter={StaticResource decreaseValueByParameterConverter}, ConverterParameter=0.5}" Y2="{Binding Path=Height, Converter={StaticResource decreaseValueByParameterConverter}, ConverterParameter=0.5}" Visibility="{Binding Path=Visibility, RelativeSource={RelativeSource AncestorType=Mathboard:EquationTypeIndicatorControl}}" />
  </Grid>
</UserControl>
