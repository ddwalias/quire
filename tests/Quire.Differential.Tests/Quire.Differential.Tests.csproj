<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Differential tests (PLAN.md §3c rule 3): call the installed Mathcad Prime assemblies and Quire's mirrored types
    with the same inputs and compare. Mathcad is never redistributed or copied: its assemblies load from the install
    (MATHCAD_DIR overrides the default path), and every test is skipped when the install is absent.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- isInt(int*) is called through reflection with a boxed pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Quire.Mpl\Quire.Mpl.csproj" />
    <ProjectReference Include="..\..\src\Quire.Engine\Quire.Engine.csproj" />
  </ItemGroup>
</Project>
