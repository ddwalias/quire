<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks comparison helpers independently of both runtime implementations. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Quire.Differential.Tests/Reflect.cs" Link="Reflect.cs" />
    <Compile Include="../Quire.Differential.Tests/MethodComparison.cs" Link="MethodComparison.cs" />
    <Compile Include="../../tools/Quire.Tools.MethodAudit/Structure.cs" Link="Structure.cs" />
    <Compile Include="../../tools/Quire.Tools.MethodAudit/Mutants.cs" Link="Mutants.cs" />
    <Compile Include="../../tools/Quire.Tools.MirrorGen/Model.cs" Link="Model.cs" />
    <Compile Include="../../tools/Quire.Tools.MirrorGen/MetadataLoader.cs" Link="MetadataLoader.cs" />
    <Compile Include="../../tools/Quire.Tools.MethodAudit/Artifact.cs" Link="Artifact.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Il.cs" Link="MemberGen/Il.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/World.cs" Link="MemberGen/World.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Names.cs" Link="MemberGen/Names.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Decompiler.cs" Link="MemberGen/Decompiler.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Renderer.cs" Link="MemberGen/Renderer.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Stubs.cs" Link="MemberGen/Stubs.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Emitter.cs" Link="MemberGen/Emitter.cs" />
    <Compile Include="../../tools/Quire.Tools.MemberGen/Emitter.Files.cs" Link="MemberGen/Emitter.Files.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- MethodAudit itself, copied beside the tests to run in process (OptimizedBuildTests). -->
    <ProjectReference Include="../../tools/Quire.Tools.MethodAudit/Quire.Tools.MethodAudit.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
